# FootNote — Environment Variables
# Copy this file to .env and fill in your API keys

# Required: Anthropic API key for AI media recognition
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Spotify API credentials (for music search + preview playback)
# Get yours at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: YouTube Data API key (for video/film search + embeds)
# Get yours at https://console.cloud.google.com
YOUTUBE_API_KEY=
